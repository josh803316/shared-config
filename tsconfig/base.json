{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ── Composition-neutral base ───────────────────────────────────────────
    // This profile carries ONLY universally-safe settings that hold across every
    // @josh803316 project regardless of runtime, emit strategy, or module system.
    // Runtime/emit/module-resolution choices deliberately live in leaf profiles:
    //   api.json, bun.json, ui.json  → Bun/Vite type-check-only (noEmit)
    //   node-esm.json, node-cjs.json → emitted Node packages
    //
    // Anything here must be safe to layer under an emitting consumer (so a package
    // can extend this and set noEmit:false / declaration:true without fighting us).
    // Keep `allowImportingTsExtensions`, `verbatimModuleSyntax`, `noEmit`,
    // `module`, and `moduleResolution` OUT of here for that reason.

    // ── Target & environment ───────────────────────────────────────────────
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force", // Treat every file as an isolated module (no accidental globals)
    "resolveJsonModule": true,

    // ── JSX ───────────────────────────────────────────────────────────────
    "jsx": "react-jsx", // modern transform; override to "preserve" in SSR/RSC/non-React

    // ── Correctness ───────────────────────────────────────────────────────
    "skipLibCheck": true,                // Avoid noise from typebox/library version skew
    "forceConsistentCasingInFileNames": true, // Prevents macOS/Windows case-sensitivity divergence

    // ── Strict type-checking ──────────────────────────────────────────────
    "strict": true,                      // All strict flags (strictNullChecks, strictFunctionTypes, …)
    "noImplicitOverride": true,          // Derived classes must mark overrides explicitly
    "noUncheckedIndexedAccess": true,    // arr[0] has type T | undefined (catches runtime crashes)
    "noFallthroughCasesInSwitch": true,  // Exhaustive switch without accidental fallthrough
    "noUncheckedSideEffectImports": true, // TS 5.6+: side-effect imports must have type info
    "noImplicitReturns": true,           // All code paths in non-void functions must return
    "allowUnusedLabels": false,          // Labels (rare) are almost always bugs
    "allowUnreachableCode": false        // Dead code after return/throw is a bug
  }
}
