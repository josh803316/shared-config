{
  "name": "@josh803316/shared-config",
  "version": "1.0.0",
  "description": "Shared compiler/linter/formatter configs for all @josh803316 TypeScript/JS projects",
  "type": "commonjs",
  "keywords": [
    "biome",
    "typescript",
    "tsconfig",
    "lint-staged",
    "husky",
    "shared-config",
    "josh803316"
  ],
  "scripts": {
    "postinstall": "bun scripts/install-husky-hooks.ts || true",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./biome.json": "./biome.json",
    "./lint-staged.config.js": "./lint-staged.config.js",
    "./tsconfig.json": "./tsconfig.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/api.json": "./tsconfig/api.json",
    "./tsconfig/ui.json": "./tsconfig/ui.json",
    "./tsconfig/bun.json": "./tsconfig/bun.json",
    "./tsconfig/node-esm.json": "./tsconfig/node-esm.json",
    "./tsconfig/test.json": "./tsconfig/test.json"
  },
  "files": [
    "biome.json",
    "lint-staged.config.js",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig/",
    "AGENTS.md",
    "bin/",
    ".husky/commit-msg",
    ".husky/pre-commit",
    "scripts/install-husky-hooks.ts",
    "README.md"
  ],
  "dependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@josh803316/shared-config"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/josh803316/shared-config.git"
  },
  "engines": {
    "node": ">=22.22.1",
    "bun": ">=1.3.0",
    "npm": "****** PLEASE USE 'bun install', NPM IS NOT SUPPORTED ******"
  }
}
