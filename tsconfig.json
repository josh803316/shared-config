{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig/base.json",
  "compilerOptions": {
    // Module — Bun-native; tsc is type-check only for this repo (Bun runs the scripts)
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // JSX default inherited from base.json (react-jsx) is not used here; keep preserve.
    "jsx": "preserve",

    // Bun types (required for TypeScript 6+ when using bun APIs in scripts)
    "types": ["bun"],

    // erasableSyntaxOnly: this repo's scripts run under Bun --strip-types, keep on
    "erasableSyntaxOnly": true
  }
}
